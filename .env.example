# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Google OAuth (customer login). Required for the "Masuk dengan Google" button,
# which is registered only when both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Jubelio API + Safar company
JUBELIO_HOST="https://api2.jubelio.com"
SAFAR_COMPANY_ID=59325

# Jubelio core-api (open platform). No static token — user-facing routes use the
# token from the Jubelio login session; system/polling routes log in with the
# default account below and derive a token from the same /login endpoint.
JUBELIO_SYSTEM_EMAIL="system@example.com"
JUBELIO_SYSTEM_PASSWORD="<password for the system/default Jubelio account>"
JUBELIO_LOCATION_ID=<from GET /core-api/locations/ — your warehouse ID>
JUBELIO_BASE_URL="https://open.jubelio.com/core-api/"

# WhatsApp — wa.me/628xxx without the + prefix
WHATSAPP_NUMBER="628xxx"

# Bank accounts (JSON array string, parsed at runtime)
BANK_ACCOUNTS=[{"bank":"BCA","account_number":"...","account_name":"..."},{"bank":"Mandiri","account_number":"...","account_name":"..."}]

# Cron — secret for protecting the daily-sync endpoint
CRON_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/saefulaskar-flash-sale"
